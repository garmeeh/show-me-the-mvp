    "cf": "1.0.0-beta.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "private": true,
  "scripts": {
    "build": "cf workers types && tsc -b && cf build",
    "cf-typegen": "cf workers types",
    "check": "cf workers types && tsc -b && cf deploy --dry-run",
    "deploy": "cf deploy",
    "dev": "cf dev",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "simple-git-hooks",
    "preview": "pnpm build && vite preview",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "!(*.{ts,tsx})": "prettier --write --ignore-unknown"
  }
}
